rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================
    // USERS collection
    // ==============================
    match /users/{userId} {
      // Users can only read/write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ==============================
    // DIAGRAMS collection
    // ==============================
    match /diagrams/{diagramId} {
      // Owner can always read their own diagrams
      // Anyone can read PUBLIC diagrams (for share page)
      allow read: if (request.auth != null && resource.data.uid == request.auth.uid)
                  || resource.data.visibility == 'public';

      // Only authenticated users can create diagrams (must set own uid)
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'title', 'data', 'createdAt', 'updatedAt']);

      // Only the owner can update or delete their diagram
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ==============================
    // GENERATIONS collection (usage tracking)
    // ==============================
    match /generations/{genId} {
      // Users can only read and create their own generation logs
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // No updates or deletes on generation logs
      allow update, delete: if false;
    }

    // ==============================
    // FEEDBACK collection
    // ==============================
    match /feedback/{feedbackId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ==============================
    // TEMPLATES collection (public read, admin write)
    // ==============================
    match /templates/{templateId} {
      // Anyone can read templates (public)
      allow read: if true;
      // Only authenticated admin writes (handled server-side)
      allow write: if false;
    }

    // ==============================
    // Deny everything else by default
    // ==============================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
